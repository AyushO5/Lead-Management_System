PORT=5000
NODE_ENV=development

# PostgreSQL connection string — replace with your own credentials
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Secret used to sign JWTs — use a long, random string in production
JWT_SECRET=

# Passwords used when running: npm run db:seed
ADMIN_SEED_PASSWORD=
MEMBER_SEED_PASSWORD=

# Test database URL (for lead_management_test on port 5433)
TEST_DATABASE_URL=

# JWT secret for .env.test (test-only, never use in production)
# TEST_JWT_SECRET=
